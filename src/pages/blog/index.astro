---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Blog" description="News, updates and behind-the-scenes notes from PlayFlex.">
  <section>
    <div class="wrap narrow">
      <h1>Blog</h1>
      <p class="meta" style="margin-bottom:24px">News, updates and behind-the-scenes notes from PlayFlex.</p>
      <ul class="post-list">
        {posts.map((p) => (
          <li>
            <a class="card" href={`/blog/${p.id}/`} style="text-decoration:none; color:inherit">
              <p class="meta">{fmt(p.data.date)}</p>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
