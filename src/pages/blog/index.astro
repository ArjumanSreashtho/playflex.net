---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Blog" description="News, updates and notes from the making of FrostSpear: Tundra Hunt.">
  <div class="page container">
    <header class="page-head">
      <h1>Blog</h1>
      <p class="meta">News, updates and notes from the making of FrostSpear.</p>
    </header>
    {posts.length > 0 ? (
      <ul class="post-list" role="list">
        {posts.map((p) => (
          <li>
            <time datetime={p.data.date.toISOString().slice(0, 10)}>{fmt(p.data.date)}</time>
            <div>
              <h3><a href={`/blog/${p.id}/`}>{p.data.title}</a></h3>
              <p>{p.data.description}</p>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p>No posts yet. The first one is on its way.</p>
    )}
  </div>
</Base>
