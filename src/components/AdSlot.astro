---
// Ad space. Shows nothing until ads are switched on.
// To switch on Google AdSense later: set PUBLIC_ADSENSE_CLIENT (e.g. ca-pub-1234567890123456)
// at build time, and pass the ad unit's slot id: <AdSlot slot="1234567890" />.
// Only blog posts load the ad script (see Base.astro 'ads'). Never on the privacy policy.
interface Props { slot?: string }
const { slot } = Astro.props;
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
---
{client && slot && (
  <aside class="ad" aria-label="Advertisement">
    <ins class="adsbygoogle" style="display:block" data-ad-client={client} data-ad-slot={slot}
         data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
